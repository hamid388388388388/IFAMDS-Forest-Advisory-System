#include <SFML/Graphics.hpp>
#include <SFML/Window.hpp>
#include <SFML/System.hpp>
#include <filesystem>
#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
#include <sstream>
#include <limits>
#include "linklist_layer.h"
#include "queue_layer.h"
#include "arraylayer.h"
#include "tree_layer.h"
#include "graph_layer.h"
#include "hash_layer.h"
#include "monitoring_layer.h"
#include "stack_layer.h"

using namespace std;

struct MenuEntry {
    std::string title;
    std::string subtitle;
};

enum MenuState { MAIN_MENU, SUB_MENU, INPUT_MODE, OUTPUT_VIEW };

// Forward declarations
int getMaxSubForMenu(int menu);
void handleSubMenuSelection(int menu, int sub, std::string& outputText, MenuState& currentState, std::string& inputPrompt, bool& waitingForInput, int& inputMin, int& inputMax, bool& isFloatInput, int& inputStep, arraylayer& obj, linklist_layer& raw_list, linklist_layer& verified_list, linklist_layer& anomaly_list, linklist_layer& forward_correcction_list, linklist_layer& elist, doubly_linklist_layer& dlist, doubly_linklist_layer& doubly_verified_list, circular_linklist_layer& clist, linklist_layer& global_list, circular_linklist_layer& global_loop, queue_layer& q1_routing, queue_layer& q2_surviellance, queue_layer& q3_emergency, queue_layer& q4_decision, tree_layer& tobj, graph_layer& gobj, hash_layer& hobj, monitoring_layer& mobj, stack_layer& sobj, bool& dlist_loaded, bool& global_loaded, bool& clist_loaded, bool& queue_paused);
void processInput(std::string input, int menu, int sub, std::string& outputText, MenuState& currentState, arraylayer& obj, linklist_layer& raw_list, linklist_layer& verified_list, linklist_layer& anomaly_list, linklist_layer& forward_correcction_list, linklist_layer& elist, doubly_linklist_layer& dlist, circular_linklist_layer& clist, linklist_layer& global_list, circular_linklist_layer& global_loop, queue_layer& q1_routing, queue_layer& q2_surviellance, queue_layer& q3_emergency, queue_layer& q4_decision, tree_layer& tobj, graph_layer& gobj, hash_layer& hobj, monitoring_layer& mobj, stack_layer& sobj, bool& dlist_loaded, bool& global_loaded, bool& clist_loaded, bool& queue_paused, int& inputStep, int& tempInput, int& humInput, int& smokeInput, int& riskT, int& riskH, int& riskS, std::string& inputPrompt, bool& waitingForInput);
void renderSubMenu(sf::RenderWindow& window, sf::Font& font, int menu, int sub, float leftMargin, float topMargin, float buttonWidth, float buttonHeight, float buttonSpacing, sf::Color normalColor, sf::Color selectedColor, float windowWidth, float windowHeight);
void renderOutput(sf::RenderWindow& window, sf::Font& font, const std::string& text, float leftMargin, float topMargin, float windowWidth, float windowHeight);
void renderInput(sf::RenderWindow& window, sf::Font& font, const std::string& prompt, const std::string& buffer, float leftMargin, float topMargin, float windowWidth, float windowHeight);

int getMaxSubForMenu(int menu)
{
    switch (menu)
    {
        case 0: return 4; // Input Environmental Data
        case 1: return 3; // View Forest Grid Status
        case 2: return 3; // View Forest Grid Status (same as 1)
        case 3: return 5; // Event Memory System
        case 4: return 4; // Fire Detection and Control (placeholder)
        case 5: return 11; // Decision System (Trees)
        case 6: return 4; // Spatial Routing System (Graphs)
        case 7: return 4; // Hash-Based Fast Access System
        case 8: return 4; // System Monitoring
        case 9: return 4; // Scenario Simulation
        case 10: return 4; // Execution Control Stack
        default: return 1;
    }
}

int main()
{
    const unsigned int windowWidth = 1200;
    const unsigned int windowHeight = 760;
    sf::RenderWindow window(sf::VideoMode(windowWidth, windowHeight), "IFAMDS Graphical Menu", sf::Style::Close);
    window.setFramerateLimit(60);

    // Load background image
    sf::Texture backgroundTexture;
    bool hasBackground = backgroundTexture.loadFromFile("pic1.jpg");
    sf::Sprite backgroundSprite;
    if (hasBackground)
    {
        backgroundSprite.setTexture(backgroundTexture);
        sf::Vector2f scale(
            static_cast<float>(windowWidth) / backgroundTexture.getSize().x,
            static_cast<float>(windowHeight) / backgroundTexture.getSize().y);
        backgroundSprite.setScale(scale);
    }
    else
    {
        std::cerr << "Warning: pic1.jpg background not found. Defaulting to plain dark theme." << std::endl;
    }

    // Load system font
    sf::Font font;
    const std::vector<std::string> fontPaths = {
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
        "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf"
    };
    bool fontLoaded = false;
    for (auto &path : fontPaths)
    {
        if (font.loadFromFile(path))
        {
            fontLoaded = true;
            break;
        }
    }
    if (!fontLoaded)
    {
        std::cerr << "Could not load system font. Please install DejaVuSans or LiberationSans." << std::endl;
        return 1;
    }

    // Initialize DSA system objects
    arraylayer obj;
    linklist_layer raw_list, verified_list, anomaly_list, forward_correcction_list, elist;
    doubly_linklist_layer dlist, doubly_verified_list;
    circular_linklist_layer clist;
    linklist_layer global_list;
    circular_linklist_layer global_loop;
    queue_layer q1_routing, q2_surviellance, q3_emergency, q4_decision;
    tree_layer tobj;
    graph_layer gobj;
    hash_layer hobj;
    monitoring_layer mobj;
    stack_layer sobj;

    // Flags
    bool dlist_loaded = false, global_loaded = false, clist_loaded = false, queue_paused = false;

    // Menu state variables
    MenuState currentState = MAIN_MENU;
    int currentMenu = 0;
    int currentSub = 0;
    std::string outputText;
    std::string inputBuffer;
    bool waitingForInput = false;
    std::string inputPrompt;
    int inputMin = 0;
    int inputMax = 100;
    bool isFloatInput = false;
    int inputStep = 0;
    int tempInput = 0;
    int humInput = 0;
    int smokeInput = 0;
    int riskT = 0;
    int riskH = 0;
    int riskS = 0;

    // Pre-load sensor data
    obj.add_sensor_data(50, 10, 80);
    obj.add_sensor_data(50, 30, 80);
    obj.add_sensor_data(50, 10, 20);
    obj.add_sensor_data(50, 40, 20);
    obj.add_sensor_data(30, 40, 80);
    obj.add_sensor_data(30, 10, 20);
    obj.add_sensor_data(55, 12, 85);
    obj.add_sensor_data(28, 60, 40);
    obj.add_sensor_data(42, 22, 65);

    int g_temps[] = {50, 50, 50, 50, 30, 30, 55, 28, 42};
    int g_humids[] = {10, 30, 10, 40, 40, 10, 12, 60, 22};
    int g_smokes[] = {80, 80, 20, 20, 80, 20, 85, 40, 65};

    gobj.load_zone_data(g_temps, g_humids, g_smokes, 9);
    gobj.build_adjacency_list();
    gobj.build_adjacency_matrix();
    hobj.load_from_sensor_data(g_temps, g_humids, g_smokes, 9);

    std::vector<MenuEntry> menuItems = {
        {"Input Environmental Data", "Add and validate sensor readings."},
        {"View Forest Grid Status", "Display the current zone matrix."},
        {"Event Memory System", "Manage linked-list event streams."},
        {"Fire Detection & Control", "Detect risk, alert and respond."},
        {"Task Scheduling System", "Queue tasks by priority."},
        {"Decision System", "Build and inspect decision trees."},
        {"Spatial Routing System", "Graph-based path analysis."},
        {"Hash-Based Fast Access", "Index and retrieve zone data."},
        {"System Monitoring", "Track load, latency and health."},
        {"Scenario Simulation", "Run high-level system scenarios."},
        {"Execution Control Stack", "Save and rollback zone state."},
        {"Launch Console Version", "Open the original IFAMDS terminal app."},
        {"Exit", "Close the graphical menu."}
    };

    const float buttonWidth = 520.0f;
    const float buttonHeight = 54.0f;
    const float buttonSpacing = 16.0f;
    const float leftMargin = 40.0f;
    const float topMargin = 140.0f;
    const sf::Color normalColor(48, 48, 48, 220);
    const sf::Color hoverColor(96, 152, 208, 220);
    const sf::Color selectedColor(192, 216, 248, 240);

    int selectedIndex = 0;

    float menuOffset = 0.0f;
    const float menuAreaTop = topMargin;
    const float menuAreaBottom = windowHeight - 120.0f;
    const float menuAreaHeight = menuAreaBottom - menuAreaTop;
    const float menuContentHeight = static_cast<float>(menuItems.size()) * (buttonHeight + buttonSpacing);
    const float scrollSpeed = 60.0f;

    auto clampMenuOffset = [&](float value) {
        float maxOffset = std::max(0.0f, menuContentHeight - menuAreaHeight);
        return std::min(std::max(value, 0.0f), maxOffset);
    };

    auto ensureSelectionVisible = [&]() {
        float itemTop = static_cast<float>(selectedIndex) * (buttonHeight + buttonSpacing);
        float itemBottom = itemTop + buttonHeight;
        if (itemBottom - menuOffset > menuAreaHeight)
        {
            menuOffset = clampMenuOffset(itemBottom - menuAreaHeight);
        }
        else if (itemTop - menuOffset < 0.0f)
        {
            menuOffset = clampMenuOffset(itemTop);
        }
    };

    ensureSelectionVisible();

    while (window.isOpen())
    {
        sf::Event event;
        while (window.pollEvent(event))
        {
            if (event.type == sf::Event::Closed)
            {
                window.close();
            }
            else if (event.type == sf::Event::KeyPressed)
            {
                if (currentState == MAIN_MENU)
                {
                    if (event.key.code == sf::Keyboard::Down)
                    {
                        selectedIndex = (selectedIndex + 1) % menuItems.size();
                        ensureSelectionVisible();
                    }
                    else if (event.key.code == sf::Keyboard::Up)
                    {
                        selectedIndex = (selectedIndex - 1 + menuItems.size()) % menuItems.size();
                        ensureSelectionVisible();
                    }
                    else if (event.key.code == sf::Keyboard::Enter)
                    {
                        if (menuItems[selectedIndex].title == "Exit")
                        {
                            window.close();
                        }
                        else if (menuItems[selectedIndex].title == "Launch Console Version")
                        {
                            // For now, still launch console
                            if (std::filesystem::exists("./ifamds"))
                            {
                                window.setVisible(false);
                                system("./ifamds");
                                window.setVisible(true);
                            }
                            else
                            {
                                currentState = OUTPUT_VIEW;
                                outputText = "Console version not found. Please compile main_console.cpp separately.";
                            }
                        }
                        else
                        {
                            currentState = SUB_MENU;
                            currentMenu = selectedIndex;
                            currentSub = 0;
                        }
                    }
                }
                else if (currentState == SUB_MENU)
                {
                    if (event.key.code == sf::Keyboard::BackSpace || event.key.code == sf::Keyboard::Escape)
                    {
                        currentState = MAIN_MENU;
                    }
                    else if (event.key.code == sf::Keyboard::Enter)
                    {
                        // Handle sub-menu selection
                        handleSubMenuSelection(currentMenu, currentSub, outputText, currentState, inputPrompt, waitingForInput, inputMin, inputMax, isFloatInput, inputStep, obj, raw_list, verified_list, anomaly_list, forward_correcction_list, elist, dlist, doubly_verified_list, clist, global_list, global_loop, q1_routing, q2_surviellance, q3_emergency, q4_decision, tobj, gobj, hobj, mobj, sobj, dlist_loaded, global_loaded, clist_loaded, queue_paused);
                    }
                    else if (event.key.code == sf::Keyboard::Down)
                    {
                        // Navigate sub-menu
                        int maxSub = getMaxSubForMenu(currentMenu);
                        currentSub = std::min(currentSub + 1, maxSub - 1);
                    }
                    else if (event.key.code == sf::Keyboard::Up)
                    {
                        int maxSub = getMaxSubForMenu(currentMenu);
                        currentSub = std::max(currentSub - 1, 0);
                    }
                }
                else if (currentState == OUTPUT_VIEW)
                {
                    if (event.key.code == sf::Keyboard::BackSpace || event.key.code == sf::Keyboard::Escape)
                    {
                        currentState = MAIN_MENU;
                    }
                }
                else if (currentState == INPUT_MODE)
                {
                    if (event.key.code == sf::Keyboard::BackSpace)
                    {
                        if (!inputBuffer.empty())
                            inputBuffer.pop_back();
                    }
                    else if (event.key.code == sf::Keyboard::Enter)
                    {
                        // Process input
                        processInput(inputBuffer, currentMenu, currentSub, outputText, currentState, obj, raw_list, verified_list, anomaly_list, forward_correcction_list, elist, dlist, clist, global_list, global_loop, q1_routing, q2_surviellance, q3_emergency, q4_decision, tobj, gobj, hobj, mobj, sobj, dlist_loaded, global_loaded, clist_loaded, queue_paused, inputStep, tempInput, humInput, smokeInput, riskT, riskH, riskS, inputPrompt, waitingForInput);
                        waitingForInput = false;
                        inputBuffer = "";
                    }
                }
            }
            else if (event.type == sf::Event::TextEntered)
            {
                if (currentState == INPUT_MODE && event.text.unicode < 128)
                {
                    char c = static_cast<char>(event.text.unicode);
                    if (c >= '0' && c <= '9' || c == '.' && isFloatInput || c == '-')
                        inputBuffer += c;
                }
            }
            else if (event.type == sf::Event::MouseWheelScrolled)
            {
                if (currentState == MAIN_MENU)
                {
                    float delta = event.mouseWheelScroll.delta;
                    menuOffset = clampMenuOffset(menuOffset - delta * scrollSpeed);
                }
            }
            else if (event.type == sf::Event::MouseMoved)
            {
                if (currentState == MAIN_MENU)
                {
                    sf::Vector2f mouse(static_cast<float>(event.mouseMove.x), static_cast<float>(event.mouseMove.y));
                    for (size_t i = 0; i < menuItems.size(); ++i)
                    {
                        float itemY = topMargin + static_cast<float>(i) * (buttonHeight + buttonSpacing) - menuOffset;
                        sf::FloatRect rect(leftMargin, itemY, buttonWidth, buttonHeight);
                        if (rect.contains(mouse))
                        {
                            selectedIndex = static_cast<int>(i);
                            break;
                        }
                    }
                }
            }
            else if (event.type == sf::Event::MouseButtonPressed && event.mouseButton.button == sf::Mouse::Left)
            {
                if (currentState == MAIN_MENU)
                {
                    sf::Vector2f mouse(static_cast<float>(event.mouseButton.x), static_cast<float>(event.mouseButton.y));
                    for (size_t i = 0; i < menuItems.size(); ++i)
                    {
                        float itemY = topMargin + static_cast<float>(i) * (buttonHeight + buttonSpacing) - menuOffset;
                        sf::FloatRect rect(leftMargin, itemY, buttonWidth, buttonHeight);
                        if (rect.contains(mouse))
                        {
                            selectedIndex = static_cast<int>(i);
                            if (menuItems[selectedIndex].title == "Exit")
                            {
                                window.close();
                            }
                            else if (menuItems[selectedIndex].title == "Launch Console Version")
                            {
                                if (std::filesystem::exists("./ifamds"))
                                {
                                    window.setVisible(false);
                                    system("./ifamds");
                                    window.setVisible(true);
                                }
                                else
                                {
                                    currentState = OUTPUT_VIEW;
                                    outputText = "Console version not found. Please compile main_console.cpp separately.";
                                }
                            }
                            else
                            {
                                currentState = SUB_MENU;
                                currentMenu = selectedIndex;
                                currentSub = -1;
                            }
                            ensureSelectionVisible();
                            break;
                        }
                    }
                }
                else if (currentState == SUB_MENU)
                {
                    // Handle sub-menu clicks if needed
                }
                else if (currentState == OUTPUT_VIEW)
                {
                    sf::Vector2f mouse(static_cast<float>(event.mouseButton.x), static_cast<float>(event.mouseButton.y));
                    sf::FloatRect backRect(leftMargin, windowHeight - 90.0f, 180.0f, 44.0f);
                    if (backRect.contains(mouse))
                    {
                        currentState = MAIN_MENU;
                    }
                }
            }
        }

        window.clear(sf::Color(24, 28, 36));
        if (hasBackground)
        {
            window.draw(backgroundSprite);
        }

        if (currentState == MAIN_MENU)
        {
            sf::Text title("IFAMDS Graphical Menu", font, 48);
            title.setFillColor(sf::Color::White);
            title.setStyle(sf::Text::Bold);
            title.setPosition(leftMargin, 28);
            window.draw(title);

            sf::Text subtitle("Use Up / Down or Mouse Wheel to scroll, Enter to open, Backspace/Escape to return.", font, 20);
            subtitle.setFillColor(sf::Color(220, 220, 220));
            subtitle.setPosition(leftMargin, 90);
            window.draw(subtitle);

            for (size_t i = 0; i < menuItems.size(); ++i)
            {
                float itemY = topMargin + static_cast<float>(i) * (buttonHeight + buttonSpacing) - menuOffset;
                if (itemY + buttonHeight < topMargin || itemY > menuAreaBottom)
                    continue;

                sf::RectangleShape button(sf::Vector2f(buttonWidth, buttonHeight));
                button.setPosition(leftMargin, itemY);
                button.setFillColor(static_cast<int>(i) == selectedIndex ? selectedColor : normalColor);
                button.setOutlineColor(sf::Color(160, 160, 160));
                button.setOutlineThickness(1.5f);
                window.draw(button);

                sf::Text text(menuItems[i].title, font, 22);
                text.setFillColor(static_cast<int>(i) == selectedIndex ? sf::Color(24, 28, 36) : sf::Color::White);
                text.setStyle(sf::Text::Bold);
                text.setPosition(leftMargin + 18, itemY + 12);
                window.draw(text);
            }

            if (menuContentHeight > menuAreaHeight)
            {
                float trackWidth = 10.0f;
                float trackLeft = leftMargin + buttonWidth + 8.0f;
                sf::RectangleShape track(sf::Vector2f(trackWidth, menuAreaHeight));
                track.setPosition(trackLeft, menuAreaTop);
                track.setFillColor(sf::Color(80, 80, 80, 180));
                window.draw(track);

                float thumbHeight = std::max(40.0f, (menuAreaHeight / menuContentHeight) * menuAreaHeight);
                float thumbY = menuAreaTop + (menuOffset / (menuContentHeight - menuAreaHeight)) * (menuAreaHeight - thumbHeight);
                sf::RectangleShape thumb(sf::Vector2f(trackWidth, thumbHeight));
                thumb.setPosition(trackLeft, thumbY);
                thumb.setFillColor(sf::Color(192, 216, 248, 220));
                window.draw(thumb);
            }

            sf::RectangleShape infoPanel(sf::Vector2f(windowWidth - buttonWidth - leftMargin * 3, windowHeight - topMargin - 60));
            infoPanel.setPosition(buttonWidth + leftMargin * 2, topMargin);
            infoPanel.setFillColor(sf::Color(0, 0, 0, 150));
            infoPanel.setOutlineColor(sf::Color(255, 255, 255, 100));
            infoPanel.setOutlineThickness(1.0f);
            window.draw(infoPanel);

            sf::Text infoTitle(menuItems[selectedIndex].title, font, 36);
            infoTitle.setFillColor(sf::Color::White);
            infoTitle.setStyle(sf::Text::Bold);
            infoTitle.setPosition(buttonWidth + leftMargin * 2 + 24, topMargin + 24);
            window.draw(infoTitle);

            sf::Text infoText(menuItems[selectedIndex].subtitle, font, 24);
            infoText.setFillColor(sf::Color(220, 220, 220));
            infoText.setPosition(buttonWidth + leftMargin * 2 + 24, topMargin + 80);
            window.draw(infoText);
        }
        else if (currentState == SUB_MENU)
        {
            renderSubMenu(window, font, currentMenu, currentSub, leftMargin, topMargin, buttonWidth, buttonHeight, buttonSpacing, normalColor, selectedColor, windowWidth, windowHeight);
        }
        else if (currentState == OUTPUT_VIEW)
        {
            renderOutput(window, font, outputText, leftMargin, topMargin, windowWidth, windowHeight);
        }
        else if (currentState == INPUT_MODE)
        {
            renderInput(window, font, inputPrompt, inputBuffer, leftMargin, topMargin, windowWidth, windowHeight);
        }

        window.display();
    }

    return 0;
}

// Helper functions - Implementation of forward declarations

void handleSubMenuSelection(int menu, int sub, std::string& outputText, MenuState& currentState, std::string& inputPrompt, bool& waitingForInput, int& inputMin, int& inputMax, bool& isFloatInput, int& inputStep, arraylayer& obj, linklist_layer& raw_list, linklist_layer& verified_list, linklist_layer& anomaly_list, linklist_layer& forward_correcction_list, linklist_layer& elist, doubly_linklist_layer& dlist, doubly_linklist_layer& doubly_verified_list, circular_linklist_layer& clist, linklist_layer& global_list, circular_linklist_layer& global_loop, queue_layer& q1_routing, queue_layer& q2_surviellance, queue_layer& q3_emergency, queue_layer& q4_decision, tree_layer& tobj, graph_layer& gobj, hash_layer& hobj, monitoring_layer& mobj, stack_layer& sobj, bool& dlist_loaded, bool& global_loaded, bool& clist_loaded, bool& queue_paused)
{
    std::stringstream ss;
    std::stringstream capture;
    std::streambuf* old;
    if (menu == 0)
    {
        if (sub == 0)
        {
            inputStep = 1;
            inputPrompt = "Enter Temperature (0-100): ";
            inputMin = 0;
            inputMax = 100;
            isFloatInput = false;
            waitingForInput = true;
            currentState = INPUT_MODE;
        }
        else if (sub == 1)
        {
            ss << "Mapping sensor readings into 2D Dynamic Terrain Grid...\n";
            obj.auto_fill_dynamic_grid();
            ss << "Dynamic grid filled with risk scores (Temp + Smoke - Humidity).\n\n";
            ss << "Displaying A4 Dynamic Terrain Expansion Matrix:\n";
            old = std::cout.rdbuf(capture.rdbuf());
            obj.display_dynamic_grid();
            std::cout.rdbuf(old);
            ss << capture.str();
            outputText = ss.str();
            currentState = OUTPUT_VIEW;
        }
        else if (sub == 2)
        {
            ss << "Static Baseline Grid (A1 - fixed reference values):\n";
            old = std::cout.rdbuf(capture.rdbuf());
            obj.display_static_grid();
            std::cout.rdbuf(old);
            ss << capture.str();
            ss << "\nLive Sensor Stream (A2 - dynamic values):\n";
            capture.str("");
            old = std::cout.rdbuf(capture.rdbuf());
            obj.display_sensor_data();
            std::cout.rdbuf(old);
            ss << capture.str();
            outputText = ss.str();
            currentState = OUTPUT_VIEW;
        }
        else if (sub == 3)
        {
            ss << "Running anomaly detection...\n";
            old = std::cout.rdbuf(capture.rdbuf());
            obj.check_anomilies();
            std::cout.rdbuf(old);
            ss << capture.str();
            ss << "\nBoundary detection:\n";
            capture.str("");
            old = std::cout.rdbuf(capture.rdbuf());
            obj.check_boundary();
            std::cout.rdbuf(old);
            ss << capture.str();
            outputText = ss.str();
            currentState = OUTPUT_VIEW;
        }
    }
    else if (menu == 1)
    {
        if (sub == 0)
        {
            ss << "A2: 1D SENSOR DATA [Time Series - Sequential]\n";
            old = std::cout.rdbuf(capture.rdbuf());
            obj.display_sensor_data();
            std::cout.rdbuf(old);
            ss << capture.str();
            outputText = ss.str();
            currentState = OUTPUT_VIEW;
        }
        else if (sub == 1)
        {
            ss << "A3/A4: 2D DYNAMIC FOREST GRID [Spatial Matrix]\nEach cell = combined risk value of that zone\n";
            obj.auto_fill_dynamic_grid();
            old = std::cout.rdbuf(capture.rdbuf());
            obj.display_dynamic_grid();
            std::cout.rdbuf(old);
            ss << capture.str();
            outputText = ss.str();
            currentState = OUTPUT_VIEW;
        }
        else if (sub == 2)
        {
            ss << "Zone-wise Conditions:\n";
            old = std::cout.rdbuf(capture.rdbuf());
            obj.check_anomilies();
            std::cout.rdbuf(old);
            ss << capture.str();
            ss << "\nBoundary:\n";
            capture.str("");
            old = std::cout.rdbuf(capture.rdbuf());
            obj.check_boundary();
            std::cout.rdbuf(old);
            ss << capture.str();
            outputText = ss.str();
            currentState = OUTPUT_VIEW;
        }
    }
    else if (menu == 5)
    {
        if (sub == 10)
        {
            inputStep = 4;
            inputPrompt = "Enter Temperature: ";
            isFloatInput = true;
            waitingForInput = true;
            currentState = INPUT_MODE;
        }
        // Add more for trees, but for now placeholder
        else
        {
            ss << "Tree option " << sub << " selected.\n";
            outputText = ss.str();
            currentState = OUTPUT_VIEW;
        }
    }
    else if (menu == 3)
    {
        if (sub == 0)
        {
            ss << "L1: RAW EVENT STREAM [Singly Linked - Direct Sensor Readings]\nStoring raw readings without any filtering...\n";
            obj.generate_events(elist);
            old = std::cout.rdbuf(capture.rdbuf());
            elist.display_event_list();
            std::cout.rdbuf(old);
            ss << capture.str();

            ss << "\nL2: VERIFIED EVENT STREAM [Noise Removed]\nFiltering invalid and out-of-range readings...\n";
            capture.str("");
            obj.verified_event_stream(verified_list);
            old = std::cout.rdbuf(capture.rdbuf());
            verified_list.display_verified_list();
            std::cout.rdbuf(old);
            ss << capture.str();

            ss << "\nL3: ANOMALY EVENT STREAM [Dangerous Readings]\nFlagging readings that deviate from normal pattern...\n";
            capture.str("");
            obj.generate_anomaly_stream(verified_list, anomaly_list);
            old = std::cout.rdbuf(capture.rdbuf());
            anomaly_list.display_event_list();
            std::cout.rdbuf(old);
            ss << capture.str();

            ss << "\nL4: FORWARD CORRECTION CHAIN [Propagated Fix]\nApplying correction forward from last verified event...\n";
            capture.str("");
            obj.forward_correction_chain(verified_list, forward_correcction_list);
            old = std::cout.rdbuf(capture.rdbuf());
            forward_correcction_list.display_forward_correction_chain();
            std::cout.rdbuf(old);
            ss << capture.str();

            outputText = ss.str();
            currentState = OUTPUT_VIEW;
        }
        else if (sub == 1)
        {
            ss << "DOUBLY LINKED LIST [Forward Traversal --->]\nReading events oldest to newest...\n";
            if (!dlist_loaded)
            {
                obj.generate_events_doubly(dlist);
                dlist_loaded = true;
            }
            old = std::cout.rdbuf(capture.rdbuf());
            dlist.display_forward();
            std::cout.rdbuf(old);
            ss << capture.str();
            outputText = ss.str();
            currentState = OUTPUT_VIEW;
        }
        else if (sub == 2)
        {
            ss << "DOUBLY LINKED LIST [Backward Traversal <---]\nReading events newest to oldest...\n";
            if (!dlist_loaded)
            {
                obj.generate_events_doubly(dlist);
                dlist_loaded = true;
            }
            old = std::cout.rdbuf(capture.rdbuf());
            dlist.display_backward();
            std::cout.rdbuf(old);
            ss << capture.str();
            outputText = ss.str();
            currentState = OUTPUT_VIEW;
        }
        else if (sub == 3)
        {
            int cycles = 3; // hardcoded for graphical
            ss << "L7: LOCAL MONITORING LOOP [Single Zone Repeat]\nContinuously monitoring Zone(0,1) for " << cycles << " cycles...\n";
            if (!clist_loaded)
            {
                obj.generate_events_circular(clist);
                clist_loaded = true;
            }
            old = std::cout.rdbuf(capture.rdbuf());
            clist.monitor_single_zone(0, 1, cycles);
            std::cout.rdbuf(old);
            ss << capture.str();

            ss << "\nL8: SYSTEM-WIDE MONITORING LOOP [All Zones]\nScanning all forest zones for " << cycles << " cycles...\n";
            capture.str("");
            old = std::cout.rdbuf(capture.rdbuf());
            clist.monitor_all_zones(cycles);
            std::cout.rdbuf(old);
            ss << capture.str();

            ss << "\nL9: EMERGENCY MONITORING LOOP [Danger Zones Only]\nFast scan mode - dangerous condition detected...\n";
            capture.str("");
            old = std::cout.rdbuf(capture.rdbuf());
            clist.emergency_monitoring_loop(cycles);
            std::cout.rdbuf(old);
            ss << capture.str();

            ss << "\nL10: STABILITY MONITORING LOOP [Long-term Check]\nMonitoring long-term forest stability...\n";
            capture.str("");
            old = std::cout.rdbuf(capture.rdbuf());
            clist.stability_monitoring_loop(cycles);
            std::cout.rdbuf(old);
            ss << capture.str();

            outputText = ss.str();
            currentState = OUTPUT_VIEW;
        }
        else if (sub == 4)
        {
            ss << "L5: BACKWARD CORRECTION CHAIN [Fix Past Events]\nTracing back through doubly linked list to correct errors...\n";
            obj.verified_event_stream(verified_list);
            obj.convert_verify_singly_to_doubly(verified_list, doubly_verified_list);
            old = std::cout.rdbuf(capture.rdbuf());
            obj.backward_correction_chain(doubly_verified_list);
            std::cout.rdbuf(old);
            ss << capture.str();

            ss << "\nL6: STATE SYNCHRONIZATION [Global Consistency]\nAll modules updated to same consistent forest state...\n";
            capture.str("");
            if (!global_loaded)
            {
                obj.state_synchronization(doubly_verified_list, global_list, global_loop);
                global_loaded = true;
            }
            old = std::cout.rdbuf(capture.rdbuf());
            global_list.display_event_list_global();
            std::cout.rdbuf(old);
            ss << capture.str();
            ss << "\n";
            capture.str("");
            old = std::cout.rdbuf(capture.rdbuf());
            global_loop.display_circular_global();
            std::cout.rdbuf(old);
            ss << capture.str();

            outputText = ss.str();
            currentState = OUTPUT_VIEW;
        }
    }
}

void processInput(std::string input, int menu, int sub, std::string& outputText, MenuState& currentState, arraylayer& obj, linklist_layer& raw_list, linklist_layer& verified_list, linklist_layer& anomaly_list, linklist_layer& forward_correcction_list, linklist_layer& elist, doubly_linklist_layer& dlist, circular_linklist_layer& clist, linklist_layer& global_list, circular_linklist_layer& global_loop, queue_layer& q1_routing, queue_layer& q2_surviellance, queue_layer& q3_emergency, queue_layer& q4_decision, tree_layer& tobj, graph_layer& gobj, hash_layer& hobj, monitoring_layer& mobj, stack_layer& sobj, bool& dlist_loaded, bool& global_loaded, bool& clist_loaded, bool& queue_paused, int& inputStep, int& tempInput, int& humInput, int& smokeInput, int& riskT, int& riskH, int& riskS, std::string& inputPrompt, bool& waitingForInput)
{
    std::stringstream ss;
    std::stringstream capture;
    std::streambuf* old;
    try {
        if (menu == 0 && sub == 0)
        {
            if (inputStep == 1)
            {
                tempInput = std::stoi(input);
                if (tempInput < 0 || tempInput > 100) throw std::out_of_range("Temp out of range");
                inputStep = 2;
                inputPrompt = "Enter Humidity (0-100): ";
            }
            else if (inputStep == 2)
            {
                humInput = std::stoi(input);
                if (humInput < 0 || humInput > 100) throw std::out_of_range("Hum out of range");
                inputStep = 3;
                inputPrompt = "Enter Smoke Level (0-100): ";
            }
            else if (inputStep == 3)
            {
                smokeInput = std::stoi(input);
                if (smokeInput < 0 || smokeInput > 100) throw std::out_of_range("Smoke out of range");
                obj.add_sensor_data(tempInput, humInput, smokeInput);
                ss << "Sensor reading added.\nTemp=" << tempInput << " Humidity=" << humInput << " Smoke=" << smokeInput << "\nReading stored in Dynamic Array A2.\n";
                outputText = ss.str();
                currentState = OUTPUT_VIEW;
                inputStep = 0;
                waitingForInput = false;
            }
        }
        else if (menu == 5 && sub == 10)
        {
            if (inputStep == 4)
            {
                riskT = std::stoi(input);
                if (riskT < 0) throw std::out_of_range("Temp negative");
                inputStep = 5;
                inputPrompt = "Enter Humidity: ";
            }
            else if (inputStep == 5)
            {
                riskH = std::stoi(input);
                if (riskH < 0) throw std::out_of_range("Hum negative");
                inputStep = 6;
                inputPrompt = "Enter Smoke Level: ";
            }
            else if (inputStep == 6)
            {
                riskS = std::stoi(input);
                if (riskS < 0) throw std::out_of_range("Smoke negative");
                ss << "Risk Score Calculator [0.4*Temp + 0.3*Smoke + 0.3*(1-Hum)]\n";
                old = std::cout.rdbuf(capture.rdbuf());
                tobj.compute_risk_score_manual(riskT, riskH, riskS);
                std::cout.rdbuf(old);
                ss << capture.str();
                outputText = ss.str();
                currentState = OUTPUT_VIEW;
                inputStep = 0;
                waitingForInput = false;
            }
        }
        else
        {
            outputText = "Input processed: " + input;
            currentState = OUTPUT_VIEW;
            waitingForInput = false;
        }
    } catch (const std::exception& e) {
        outputText = "Error: " + std::string(e.what()) + ". Please enter valid number.";
        currentState = OUTPUT_VIEW;
        waitingForInput = false;
        inputStep = 0;
    }
}

void renderSubMenu(sf::RenderWindow& window, sf::Font& font, int menu, int sub, float leftMargin, float topMargin, float buttonWidth, float buttonHeight, float buttonSpacing, sf::Color normalColor, sf::Color selectedColor, float windowWidth, float windowHeight)
{
    std::vector<std::string> subItems;
    std::string title;
    switch (menu)
    {
        case 0: 
            title = "Input Environmental Data";
            subItems = {"Add Sensor Reading", "Store Data in Dynamic Array", "Compare with Static Baseline", "Validate and Filter Noise"};
            break;
        case 1:
            title = "View Forest Grid Status";
            subItems = {"Display 1D Time Series Data", "Display 2D Forest Zone Matrix", "View Zone-wise Conditions"};
            break;
        case 2:
            title = "Event Memory System";
            subItems = {"L1-L4: Raw/Verified/Anomaly/Forward", "Doubly LL - Forward Traversal", "Doubly LL - Backward Traversal", "L7-L10: Circular Monitoring Loops", "L5+L6: Backward Correction + State Sync"};
            break;
        case 3:
            title = "Fire Detection & Control";
            subItems = {"Detect Fire Risk", "Trigger Emergency Alert", "Priority-Based Fire Response", "Simulate Fire Spread", "Allocate Firefighting Resources"};
            break;
        case 4:
            title = "Task Scheduling System";
            subItems = {"Add Routine Task", "Add Surveillance Task", "Add Emergency Task", "Process Tasks", "Pause and Resume Tasks", "Build Queues from Global State", "Display All Queues"};
            break;
        case 5:
            title = "Decision System";
            subItems = {"Build All 12 Trees", "T1: Zone Hierarchy", "T2: Sub-Zone Decomposition", "T3: Terrain Classification", "T4: Water Resource", "T5: Fire Control Resource", "T6: Equipment Allocation", "T7: Fire Classification", "T8: Wildlife Activity", "T9: Human Activity", "Compute Risk Score", "T10: Zone-Level Decision", "T11: Regional Escalation Decision", "T12: Global Emergency Decision", "Execute Final Action"};
            break;
        case 6:
            title = "Spatial Routing System";
            subItems = {"Display Zone Status", "Display G1: Adjacency List", "Display G2: Adjacency Matrix", "BFS Traversal", "DFS Traversal", "Compute Safe Rescue Path", "Update Blocked Routes"};
            break;
        case 7:
            title = "Hash-Based Fast Access";
            subItems = {"Insert Zone Data", "Retrieve Zone Data", "View Collision Chain Table", "Update Cache", "View Index Table", "View All", "Update Zone Data"};
            break;
        case 8:
            title = "System Monitoring";
            subItems = {"Monitor System Load", "Track Execution Time", "Detect Bottlenecks", "Optimize Performance", "View System Health Dashboard"};
            break;
        case 9:
            title = "Scenario Simulation";
            subItems = {"Cascading Fire Scenario", "Sensor Failure Scenario", "Multi-Factor Anomaly Scenario", "System Overload Scenario", "Global Emergency Scenario", "Run Full System Simulation"};
            break;
        case 10:
            title = "Execution Control Stack";
            subItems = {"Push/Save Current Zone State", "Pop State", "Peek Top State", "Rollback to Last Saved State", "Display All Saved States", "Clear Stack"};
            break;
        default: 
            title = "Sub Menu";
            subItems = {"Option 1"};
    }

    sf::Text menuTitle(title, font, 48);
    menuTitle.setFillColor(sf::Color::White);
    menuTitle.setStyle(sf::Text::Bold);
    menuTitle.setPosition(leftMargin, 28);
    window.draw(menuTitle);

    sf::Text subtitle("Use Up/Down, Enter to select, Backspace to return.", font, 20);
    subtitle.setFillColor(sf::Color(220, 220, 220));
    subtitle.setPosition(leftMargin, 90);
    window.draw(subtitle);

    float menuAreaTop = topMargin;
    float menuAreaBottom = windowHeight - 120.0f;
    float menuAreaHeight = menuAreaBottom - menuAreaTop;
    float menuContentHeight = static_cast<float>(subItems.size()) * (buttonHeight + buttonSpacing);
    float menuOffset = 0.0f;
    if (menuContentHeight > menuAreaHeight)
    {
        // Simple scroll if needed, but for now, assume fits or handle later
    }

    for (size_t i = 0; i < subItems.size(); ++i)
    {
        float itemY = topMargin + static_cast<float>(i) * (buttonHeight + buttonSpacing) - menuOffset;
        if (itemY + buttonHeight < topMargin || itemY > menuAreaBottom) continue;

        sf::RectangleShape button(sf::Vector2f(buttonWidth, buttonHeight));
        button.setPosition(leftMargin, itemY);
        button.setFillColor(static_cast<int>(i) == sub ? selectedColor : normalColor);
        button.setOutlineColor(sf::Color(160, 160, 160));
        button.setOutlineThickness(1.5f);
        window.draw(button);

        sf::Text text(subItems[i], font, 22);
        text.setFillColor(static_cast<int>(i) == sub ? sf::Color(24, 28, 36) : sf::Color::White);
        text.setStyle(sf::Text::Bold);
        text.setPosition(leftMargin + 18, itemY + 12);
        window.draw(text);
    }
}

void renderOutput(sf::RenderWindow& window, sf::Font& font, const std::string& text, float leftMargin, float topMargin, float windowWidth, float windowHeight)
{
    sf::RectangleShape panel(sf::Vector2f(windowWidth - leftMargin * 2, windowHeight - leftMargin * 2));
    panel.setPosition(leftMargin, leftMargin);
    panel.setFillColor(sf::Color(16, 24, 40, 220));
    window.draw(panel);

    sf::Text outputText(text, font, 18);
    outputText.setFillColor(sf::Color::White);
    outputText.setPosition(leftMargin + 22, leftMargin + 22);
    // For scrolling, but for now, display as is. If too long, it will clip, but SFML handles it.

    window.draw(outputText);

    sf::RectangleShape backButton(sf::Vector2f(180.0f, 44.0f));
    backButton.setPosition(leftMargin, windowHeight - 90.0f);
    backButton.setFillColor(sf::Color(96, 152, 208, 220));
    window.draw(backButton);

    sf::Text backText("Back", font, 24);
    backText.setFillColor(sf::Color::Black);
    backText.setPosition(leftMargin + 64.0f, windowHeight - 84.0f);
    window.draw(backText);
}

void renderInput(sf::RenderWindow& window, sf::Font& font, const std::string& prompt, const std::string& buffer, float leftMargin, float topMargin, float windowWidth, float windowHeight)
{
    sf::RectangleShape panel(sf::Vector2f(windowWidth - leftMargin * 2, windowHeight - leftMargin * 2));
    panel.setPosition(leftMargin, leftMargin);
    panel.setFillColor(sf::Color(16, 24, 40, 220));
    window.draw(panel);

    sf::Text promptText(prompt, font, 24);
    promptText.setFillColor(sf::Color::White);
    promptText.setPosition(leftMargin + 22, leftMargin + 22);
    window.draw(promptText);

    sf::Text inputText(buffer, font, 24);
    inputText.setFillColor(sf::Color::Yellow);
    inputText.setPosition(leftMargin + 22, leftMargin + 80);
    window.draw(inputText);
}
